// VLR-06V rear clearance reference
// Simplified body and retainer envelope; not a connector model or print part.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

bodyWidth = 19.6mm
bodyHeight = 15mm
rearProjection = 18.7mm
rearProfile = sketch(on = XY) {
  bottom = line(start = [var -9.8mm, var -7.5mm], end = [var 9.8mm, var -7.5mm])
  right = line(start = [var 9.8mm, var -7.5mm], end = [var 9.8mm, var 7.5mm])
  top = line(start = [var 9.8mm, var 7.5mm], end = [var -9.8mm, var 7.5mm])
  left = line(start = [var -9.8mm, var 7.5mm], end = [var -9.8mm, var -7.5mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == bodyWidth / 2
  verticalDistance([bottom.start, ORIGIN]) == bodyHeight / 2
  horizontalDistance([bottom.start, bottom.end]) == bodyWidth
  verticalDistance([right.start, right.end]) == bodyHeight
}
rearRegion = region(segments = [rearProfile.bottom, rearProfile.right], intersectionIndex = -1, direction = CCW)
hide(rearProfile)
rearEnvelope = extrude(rearRegion, length = rearProjection)
