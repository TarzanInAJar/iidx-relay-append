// End wall support blank.
// Vertical slide channels are cut after joining it to the frame.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)
trackHeight = 78.8mm
trackWidth = 8mm
trackDepth = 10.8mm
profile = sketch(on = XY) {
  bottom = line(start = [var -4mm, var 0mm], end = [var 4mm, var 0mm])
  right = line(start = [var 4mm, var 0mm], end = [var 4mm, var 10.8mm])
  top = line(start = [var 4mm, var 10.8mm], end = [var -4mm, var 10.8mm])
  left = line(start = [var -4mm, var 10.8mm], end = [var -4mm, var 0mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  horizontal(top)
  vertical(right)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == trackWidth / 2
  horizontal([bottom.start, ORIGIN])
  horizontalDistance([bottom.start, bottom.end]) == trackWidth
  verticalDistance([right.start, right.end]) == trackDepth
}
blank = extrude(region(segments = [profile.bottom, profile.right], intersectionIndex = -1, direction = CCW), length = trackHeight)
hide(profile)
endSupport = blank
