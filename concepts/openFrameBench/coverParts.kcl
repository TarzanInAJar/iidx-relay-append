// Open-frame cover part exports.
// Covers are installed by the separate closed assembly view.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)
import "sideCover.kcl" as sidePart
import "endCover.kcl" as eastPart
import "westCover.kcl" as westPart
export sideSkin = sidePart
export eastSkin = eastPart
export westSkin = westPart
