// Solid east-end sliding panel.
// Fits the same 3 mm channel as the west connector panel.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

wallWidth = 61.2mm
wallHeight = 78.6mm
wallThickness = 3mm
profile = sketch(on = YZ) {
  bottom = line(start = [var -30.6mm, var 0mm], end = [var 30.6mm, var 0mm])
  right = line(start = [var 30.6mm, var 0mm], end = [var 30.6mm, var 78.6mm])
  top = line(start = [var 30.6mm, var 78.6mm], end = [var -30.6mm, var 78.6mm])
  left = line(start = [var -30.6mm, var 78.6mm], end = [var -30.6mm, var 0mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  horizontal(top)
  vertical(right)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == wallWidth / 2
  horizontal([bottom.start, ORIGIN])
  horizontalDistance([bottom.start, bottom.end]) == wallWidth
  verticalDistance([right.start, right.end]) == wallHeight
}
blank = extrude(region(segments = [profile.bottom, profile.right], intersectionIndex = -1, direction = CCW), length = wallThickness)
hide(profile)
eastSlide = blank
