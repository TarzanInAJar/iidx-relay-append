// West cover exposes the stacked connector plate and its screws.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

// Independent blank keeps the east cover out of the standalone west export.
blankProfile = sketch(on = YZ) {
  base = line(start = [var -38mm, var 0mm], end = [var 38mm, var 0mm])
  right = line(start = [var 38mm, var 0mm], end = [var 38mm, var 85mm])
  top = line(start = [var 38mm, var 85mm], end = [var -38mm, var 85mm])
  left = line(start = [var -38mm, var 85mm], end = [var -38mm, var 0mm])
  coincident([base.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, base.start])
  horizontal(base)
  horizontal(top)
  vertical(right)
  vertical(left)
  horizontalDistance([base.start, ORIGIN]) == 38mm
  horizontal([base.start, ORIGIN])
  horizontalDistance([base.start, base.end]) == 76mm
  verticalDistance([right.start, right.end]) == 85mm
}
blank = extrude(region(segments = [blankProfile.base, blankProfile.right], intersectionIndex = -1, direction = CCW), length = 2mm)
hide(blankProfile)
mountProfile = sketch(on = YZ) {
  hole = circle(center = [var 0mm, var 0mm], start = [var 1.7mm, var 0mm])
  coincident([hole.center, ORIGIN])
  horizontal([hole.center, hole.start])
  radius(hole) == 1.7mm
}
firstHole = extrude(region(segments = [mountProfile.hole]), length = 2.4mm)
  |> translate(
       x = -0.2mm,
       y = -27mm,
       z = 31mm,
       global = true,
     )
hide(mountProfile)
holeTools = patternLinear3d(
  firstHole,
  instances = 2,
  distance = 54mm,
  axis = [0, 1, 0],
)
  |> patternLinear3d(instances = 2, distance = 35mm, axis = [0, 0, 1])
endBlank = subtract(blank, tools = holeTools)
openingWidth = 50.4mm
openingBottom = 8.2mm
openingHeight = 78mm
opening = sketch(on = YZ) {
  bottom = line(start = [var -25.2mm, var 8.2mm], end = [var 25.2mm, var 8.2mm])
  right = line(start = [var 25.2mm, var 8.2mm], end = [var 25.2mm, var 86.2mm])
  top = line(start = [var 25.2mm, var 86.2mm], end = [var -25.2mm, var 86.2mm])
  left = line(start = [var -25.2mm, var 86.2mm], end = [var -25.2mm, var 8.2mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  horizontal(top)
  vertical(right)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == openingWidth / 2
  verticalDistance([ORIGIN, bottom.start]) == openingBottom
  horizontalDistance([bottom.start, bottom.end]) == openingWidth
  verticalDistance([right.start, right.end]) == openingHeight
}
tool = extrude(region(segments = [opening.bottom, opening.right], intersectionIndex = -1, direction = CCW), length = 3mm)
  |> translate(x = -0.5mm, global = true)
hide(opening)
westCover = subtract(endBlank, tools = [tool])
