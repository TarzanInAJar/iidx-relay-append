// Dual VL supply side panel
// +12 V and +5 V input openings in one interchangeable slide-in panel.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

import "vlTwoPanelCutter.kcl" as twoPortTool
import "vlSixPanelCutter.kcl" as sixPortTool

panelLength = 84mm
panelHeight = 60.6mm
panelThickness = 3mm
panelProfile = sketch(on = XY) {
  bottom = line(start = [var -42mm, var -30.3mm], end = [var 42mm, var -30.3mm])
  right = line(start = [var 42mm, var -30.3mm], end = [var 42mm, var 30.3mm])
  top = line(start = [var 42mm, var 30.3mm], end = [var -42mm, var 30.3mm])
  left = line(start = [var -42mm, var 30.3mm], end = [var -42mm, var -30.3mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == panelLength / 2
  verticalDistance([bottom.start, ORIGIN]) == panelHeight / 2
  horizontalDistance([bottom.start, bottom.end]) == panelLength
  verticalDistance([right.start, right.end]) == panelHeight
}
panelBlank = extrude(
  region(
    segments = [
      panelProfile.bottom,
      panelProfile.right
    ],
    intersectionIndex = -1,
    direction = CCW,
  ),
  length = panelThickness,
)
hide(panelProfile)

portPitch = 40mm
portHeight = 4.5mm
twoPortPositioned = translate(
  twoPortTool,
  x = portPitch / 2,
  y = portHeight,
  global = true,
)
panelWithTwo = subtract(panelBlank, tools = [twoPortPositioned])
sixPortPositioned = translate(
  sixPortTool,
  x = -portPitch / 2,
  y = portHeight,
  global = true,
)
supplyPanelBoth = subtract(panelWithTwo, tools = [sixPortPositioned])
