// Ten-port WAGO cradle for independently screwed end keepers.
// Lever, wire and keeper retention clearances require physical verification.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

bodyWidth = 29.6mm
bodyHeight = 18.1mm
fitClearance = 0.2mm
wallThickness = 2mm
baseThickness = 1.6mm
baseLength = bodyWidth + fitClearance + 2 * wallThickness
baseWidth = 36mm
railWidth = 8mm
railTopClearance = 1mm
fastenerOffset = 14.5mm
fastenerRadius = 1.6mm
bodyDepth = 15.6mm
stopClearance = 0.3mm
stopThickness = 1.6mm
stopWidth = 2.4mm
stopInset = 0.9mm
stopHeight = 3mm
stopX = (bodyWidth + fitClearance) / 2 - stopInset + stopWidth / 2
stopY = (bodyDepth + stopClearance + stopThickness) / 2

baseProfile = sketch(on = XY) {
  bottom = line(start = [var -16.7mm, var -18mm], end = [var 16.7mm, var -18mm])
  right = line(start = [var 16.7mm, var -18mm], end = [var 16.7mm, var 18mm])
  top = line(start = [var 16.7mm, var 18mm], end = [var -16.7mm, var 18mm])
  left = line(start = [var -16.7mm, var 18mm], end = [var -16.7mm, var -18mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == baseLength / 2
  verticalDistance([bottom.start, ORIGIN]) == baseWidth / 2
  horizontalDistance([bottom.start, bottom.end]) == baseLength
  verticalDistance([right.start, right.end]) == baseWidth
}
base = extrude(region(segments = [baseProfile.bottom, baseProfile.right], intersectionIndex = -1, direction = CCW), length = baseThickness)
hide(baseProfile)

railProfile = sketch(on = XZ) {
  bottom = line(start = [var 14.9mm, var 1.4mm], end = [var 16.9mm, var 1.4mm])
  outer = line(start = [var 16.9mm, var 1.4mm], end = [var 16.9mm, var 20.7mm])
  top = line(start = [var 16.9mm, var 20.7mm], end = [var 14.9mm, var 20.7mm])
  inner = line(start = [var 14.9mm, var 20.7mm], end = [var 14.9mm, var 1.4mm])
  coincident([bottom.end, outer.start])
  coincident([outer.end, top.start])
  coincident([top.end, inner.start])
  coincident([inner.end, bottom.start])
  horizontal(bottom)
  vertical(outer)
  horizontal(top)
  vertical(inner)
  horizontalDistance([ORIGIN, bottom.end]) == baseLength / 2
  verticalDistance([ORIGIN, bottom.start]) == baseThickness - 0.2mm
  horizontalDistance([bottom.start, bottom.end]) == wallThickness
  verticalDistance([outer.start, outer.end]) == bodyHeight + railTopClearance + 0.2mm
}
rail = extrude(region(segments = [railProfile.bottom, railProfile.outer], intersectionIndex = -1, direction = CCW), length = railWidth, direction = [0, 1, 0])
  |> translate(y = -railWidth / 2, global = true)
hide(railProfile)
otherRail = rotate(
  clone(rail),
  axis = Z,
  angle = 180deg,
  global = true,
)
baseWithRail = union([base, rail])
retainerBody = union([baseWithRail, otherRail])

// Short corner stops limit sliding while keeping the center of each face open.
stopProfile = sketch(on = XY) {
  bottom = line(start = [var -1.2mm, var -0.8mm], end = [var 1.2mm, var -0.8mm])
  right = line(start = [var 1.2mm, var -0.8mm], end = [var 1.2mm, var 0.8mm])
  top = line(start = [var 1.2mm, var 0.8mm], end = [var -1.2mm, var 0.8mm])
  left = line(start = [var -1.2mm, var 0.8mm], end = [var -1.2mm, var -0.8mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == stopWidth / 2
  verticalDistance([bottom.start, ORIGIN]) == stopThickness / 2
  horizontalDistance([bottom.start, bottom.end]) == stopWidth
  verticalDistance([right.start, right.end]) == stopThickness
}
stopBlank = extrude(region(segments = [stopProfile.bottom, stopProfile.right], intersectionIndex = -1, direction = CCW), length = stopHeight + 0.1mm)
  |> translate(
       x = stopX,
       y = stopY,
       z = baseThickness - 0.1mm,
       global = true,
     )
hide(stopProfile)
stopTools = patternLinear3d(
  stopBlank,
  instances = 2,
  distance = 2 * stopX,
  axis = [-1, 0, 0],
)
  |> patternLinear3d(instances = 2, distance = 2 * stopY, axis = [0, -1, 0])
retainerWithStopOne = union([retainerBody, stopTools[0]])
retainerWithStopTwo = union([retainerWithStopOne, stopTools[1]])
retainerWithStopThree = union([retainerWithStopTwo, stopTools[2]])
retainerWithStops = union([retainerWithStopThree, stopTools[3]])

holeProfile = sketch(on = XY) {
  hole = circle(center = [var 0mm, var 0mm], start = [var 1.6mm, var 0mm])
  coincident([hole.center, ORIGIN])
  radius(hole) == fastenerRadius
  horizontal([hole.center, hole.start])
}
hole = extrude(region(segments = [holeProfile.hole]), length = baseThickness + 2mm)
  |> translate(y = -fastenerOffset, z = -1mm, global = true)
hide(holeProfile)
holes = patternLinear3d(
  hole,
  instances = 2,
  distance = 2 * fastenerOffset,
  axis = [0, 1, 0],
)
tenRetainer = subtract(retainerWithStops, tools = holes)
