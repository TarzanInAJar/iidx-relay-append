@settings(defaultLengthUnit = mm, kclVersion = 3.0)

// Simplified overall body envelope of a WAGO 221-420; levers and ports omitted.
wagoWidth = 29.8mm
wagoDepth = 18.3mm
wagoHeight = 15.8mm

bodyProfile = sketch(on = XY) {
  bottom = line(start = [var -14.9mm, var -9.15mm], end = [var 14.9mm, var -9.15mm])
  right = line(start = [var 14.9mm, var -9.15mm], end = [var 14.9mm, var 9.15mm])
  top = line(start = [var 14.9mm, var 9.15mm], end = [var -14.9mm, var 9.15mm])
  left = line(start = [var -14.9mm, var 9.15mm], end = [var -14.9mm, var -9.15mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == wagoWidth / 2
  verticalDistance([bottom.start, ORIGIN]) == wagoDepth / 2
  horizontalDistance([bottom.start, bottom.end]) == wagoWidth
  verticalDistance([right.start, right.end]) == wagoDepth
}
bodyRegion = region(segments = [bodyProfile.bottom, bodyProfile.right], intersectionIndex = -1, direction = CCW)
hide(bodyProfile)
tenPortEnvelope = extrude(bodyRegion, length = wagoHeight)
