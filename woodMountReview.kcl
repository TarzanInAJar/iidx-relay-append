// Assembly review of the removable wood-mount clips on the open-frame box.
// The wood surface is at z = -3 mm; connector bodies and fasteners are omitted.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

import "concepts/openFrameBench/main.kcl" as framePart
import plainSkin, eastSkin from "concepts/openFrameSlideWalls/main.kcl"
import "openFrameCeiling.kcl" as ceilingPart
import "openFrameSupplyTwo.kcl" as twoPart
import "openFrameSupplySix.kcl" as sixPart
import "openFrameWestSlide.kcl" as westPart
import "woodMountClip.kcl" as clipPart

frame = appearance(framePart, color = "#728a7f")
ceiling = translate(ceilingPart, z = 82mm, global = true)
  |> appearance(color = "#d6dadd")
westPanel = translate(
  westPart,
  x = 115mm,
  z = 36mm,
  global = true,
)
  |> appearance(color = "#a8c2cb")
northPanel = rotate(
  twoPart,
  axis = X,
  angle = 90deg,
  global = true,
)
  |> rotate(axis = Z, angle = 180deg, global = true)
  |> translate(
       x = -55mm,
       y = 33.4mm,
       z = 42.5mm,
       global = true,
     )
  |> appearance(color = "#56646d")
southPanel = rotate(
  sixPart,
  axis = X,
  angle = 90deg,
  global = true,
)
  |> translate(
       x = -55mm,
       y = -33.4mm,
       z = 42.5mm,
       global = true,
     )
  |> appearance(color = "#56646d")
northPlainWall = translate(
  clone(plainSkin),
  x = 55mm,
  y = 36.4mm,
  z = 3.2mm,
  global = true,
)
  |> appearance(color = "#56646d")
southPlainWall = translate(
  plainSkin,
  x = 55mm,
  y = -34.8mm,
  z = 3.2mm,
  global = true,
)
  |> appearance(color = "#56646d")
eastPanel = rotate(
  eastSkin,
  axis = Z,
  angle = 180deg,
  global = true,
)
  |> translate(x = -115mm, z = 3.2mm, global = true)
  |> appearance(color = "#687983")

northWestBlank = clone(clipPart)
southEastBlank = clone(clipPart)
southWestBlank = clone(clipPart)
northEastClip = translate(
  clipPart,
  x = -100mm,
  y = 38.35mm,
  z = -3mm,
  global = true,
)
  |> appearance(color = "#e4ad55")
northWestClip = translate(
  northWestBlank,
  x = 90mm,
  y = 38.35mm,
  z = -3mm,
  global = true,
)
  |> appearance(color = "#e4ad55")
southEastClip = translate(
  rotate(
    southEastBlank,
    axis = Z,
    angle = 180deg,
    global = true,
  ),
  x = -100mm,
  y = -38.35mm,
  z = -3mm,
  global = true,
)
  |> appearance(color = "#e4ad55")
southWestClip = translate(
  rotate(
    southWestBlank,
    axis = Z,
    angle = 180deg,
    global = true,
  ),
  x = 90mm,
  y = -38.35mm,
  z = -3mm,
  global = true,
)
  |> appearance(color = "#e4ad55")
