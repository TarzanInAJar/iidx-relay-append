// Internal wiring carrier
// Removable plate with tray mounting holes and diagonal carrier-stack holes.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

carrierLength = 180mm
carrierWidth = 40mm
carrierThickness = 2mm
fastenerX = 78mm
clearanceRadius = 1.7mm
wireTieSlotWidth = 4mm
wireTieSlotHeight = 2mm
tieTabWidth = 8mm
tieTabDepth = 8.1mm
tieTabCenterY = carrierWidth / 2 + tieTabDepth / 2 - 0.1mm
tieSlotOuterY = carrierWidth / 2 + 5.5mm
tieSlotPairPitch = 4mm

carrierProfile = sketch(on = XY) {
  bottom = line(start = [var -90mm, var -20mm], end = [var 90mm, var -20mm])
  right = line(start = [var 90mm, var -20mm], end = [var 90mm, var 20mm])
  top = line(start = [var 90mm, var 20mm], end = [var -90mm, var 20mm])
  left = line(start = [var -90mm, var 20mm], end = [var -90mm, var -20mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == carrierLength / 2
  verticalDistance([bottom.start, ORIGIN]) == carrierWidth / 2
  horizontalDistance([bottom.start, bottom.end]) == carrierLength
  verticalDistance([right.start, right.end]) == carrierWidth
}
carrierBlank = extrude(
  region(
    segments = [
      carrierProfile.bottom,
      carrierProfile.right
    ],
    intersectionIndex = -1,
    direction = CCW,
  ),
  length = carrierThickness,
)
hide(carrierProfile)

// Side tabs keep tie slots outside the retainer footprints.
tieTabProfile = sketch(on = XY) {
  bottom = line(start = [var -4mm, var -4.05mm], end = [var 4mm, var -4.05mm])
  right = line(start = [var 4mm, var -4.05mm], end = [var 4mm, var 4.05mm])
  top = line(start = [var 4mm, var 4.05mm], end = [var -4mm, var 4.05mm])
  left = line(start = [var -4mm, var 4.05mm], end = [var -4mm, var -4.05mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == tieTabWidth / 2
  verticalDistance([bottom.start, ORIGIN]) == tieTabDepth / 2
  horizontalDistance([bottom.start, bottom.end]) == tieTabWidth
  verticalDistance([right.start, right.end]) == tieTabDepth
}
tieTab = extrude(
  region(
    segments = [
      tieTabProfile.bottom,
      tieTabProfile.right
    ],
    intersectionIndex = -1,
    direction = CCW,
  ),
  length = carrierThickness,
)
hide(tieTabProfile)
southTabFirst = translate(
  clone(tieTab),
  x = -36mm,
  y = -tieTabCenterY,
  global = true,
)
northTabFirst = translate(
  tieTab,
  x = -36mm,
  y = tieTabCenterY,
  global = true,
)
southTabs = patternLinear3d(
  southTabFirst,
  instances = 3,
  distance = 36mm,
  axis = [1, 0, 0],
)
northTabs = patternLinear3d(
  northTabFirst,
  instances = 3,
  distance = 36mm,
  axis = [1, 0, 0],
)
carrierWithSouthTabOne = union([carrierBlank, southTabs[0]])
carrierWithSouthTabTwo = union([carrierWithSouthTabOne, southTabs[1]])
carrierWithSouthTabs = union([carrierWithSouthTabTwo, southTabs[2]])
carrierWithNorthTabOne = union([carrierWithSouthTabs, northTabs[0]])
carrierWithNorthTabTwo = union([carrierWithNorthTabOne, northTabs[1]])
carrierWithTabs = union([carrierWithNorthTabTwo, northTabs[2]])

holeProfile = sketch(on = XY) {
  holeCircle = circle(center = [var 0mm, var 0mm], start = [var 1.7mm, var 0mm])
  coincident([holeCircle.center, ORIGIN])
  radius(holeCircle) == clearanceRadius
  horizontal([holeCircle.center, holeCircle.start])
}
holeTool = extrude(region(segments = [holeProfile.holeCircle]), length = carrierThickness + 2mm)
  |> translate(x = -fastenerX, z = -1mm, global = true)
hide(holeProfile)
// Two separate diagonal holes let the upper and lower plates be bolted
// together independently of the two fasteners holding the carrier to the tray.
stackHoleBlank = clone(holeTool)
stackHoleEast = translate(
  stackHoleBlank,
  x = -6mm,
  y = 13mm,
  global = true,
)
stackHoleWest = translate(
  clone(stackHoleEast),
  x = 168mm,
  y = -26mm,
  global = true,
)
holeTools = patternLinear3d(
  holeTool,
  instances = 2,
  distance = 2 * fastenerX,
  axis = [1, 0, 0],
)
carrierWithTrayHoles = subtract(carrierWithTabs, tools = holeTools)
carrierWithEastStackHole = subtract(carrierWithTrayHoles, tools = [stackHoleEast])
carrierWithStackHoles = subtract(carrierWithEastStackHole, tools = [stackHoleWest])

// Paired tie slots in side tabs clear the retainer bases.
wireTieProfile = sketch(on = XY) {
  bottom = line(start = [var -2mm, var -1mm], end = [var 2mm, var -1mm])
  right = line(start = [var 2mm, var -1mm], end = [var 2mm, var 1mm])
  top = line(start = [var 2mm, var 1mm], end = [var -2mm, var 1mm])
  left = line(start = [var -2mm, var 1mm], end = [var -2mm, var -1mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == wireTieSlotWidth / 2
  verticalDistance([bottom.start, ORIGIN]) == wireTieSlotHeight / 2
  horizontalDistance([bottom.start, bottom.end]) == wireTieSlotWidth
  verticalDistance([right.start, right.end]) == wireTieSlotHeight
}
wireTieRegion = region(
  segments = [
    wireTieProfile.bottom,
    wireTieProfile.right
  ],
  intersectionIndex = -1,
  direction = CCW,
)
hide(wireTieProfile)
southTieBlank = extrude(wireTieRegion, length = carrierThickness + 2mm)
  |> translate(
       x = -36mm,
       y = -tieSlotOuterY,
       z = -1mm,
       global = true,
     )
northTieBlank = translate(clone(southTieBlank), y = 2 * tieSlotOuterY - tieSlotPairPitch, global = true)
southTieSlots = patternLinear3d(
  southTieBlank,
  instances = 3,
  distance = 36mm,
  axis = [1, 0, 0],
)
  |> patternLinear3d(instances = 2, distance = tieSlotPairPitch, axis = [0, 1, 0])
northTieSlots = patternLinear3d(
  northTieBlank,
  instances = 3,
  distance = 36mm,
  axis = [1, 0, 0],
)
  |> patternLinear3d(instances = 2, distance = tieSlotPairPitch, axis = [0, 1, 0])
carrierWithSouthTies = subtract(carrierWithStackHoles, tools = southTieSlots)
carrierWithTies = subtract(carrierWithSouthTies, tools = northTieSlots)

// Through-holes match the two M3 clearance holes in each accepted retainer.
retainerPitch = 36mm
retainerHoleOffset = 14.5mm
retainerHoleProfile = sketch(on = XY) {
  hole = circle(center = [var 0mm, var 0mm], start = [var 1.7mm, var 0mm])
  coincident([hole.center, ORIGIN])
  radius(hole) == clearanceRadius
  horizontal([hole.center, hole.start])
}
retainerHoleBlank = extrude(region(segments = [retainerHoleProfile.hole]), length = carrierThickness + 2mm)
  |> translate(
       x = -1.5 * retainerPitch,
       y = -retainerHoleOffset,
       z = -1mm,
       global = true,
     )
hide(retainerHoleProfile)
retainerHoleTools = patternLinear3d(
  retainerHoleBlank,
  instances = 4,
  distance = retainerPitch,
  axis = [1, 0, 0],
)
  |> patternLinear3d(instances = 2, distance = 2 * retainerHoleOffset, axis = [0, 1, 0])
carrier = subtract(carrierWithTies, tools = retainerHoleTools)
