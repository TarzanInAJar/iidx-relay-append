// Enclosure tray
// Open-top enclosure with a removable ceiling, carrier and west connector panel.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

trayLength = 230mm
trayWidth = 70mm
trayHeight = 69mm
wallThickness = 3mm

outerProfile = sketch(on = XY) {
  bottom = line(start = [var -115mm, var -35mm], end = [var 115mm, var -35mm])
  right = line(start = [var 115mm, var -35mm], end = [var 115mm, var 35mm])
  top = line(start = [var 115mm, var 35mm], end = [var -115mm, var 35mm])
  left = line(start = [var -115mm, var 35mm], end = [var -115mm, var -35mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == trayLength / 2
  verticalDistance([bottom.start, ORIGIN]) == trayWidth / 2
  horizontalDistance([bottom.start, bottom.end]) == trayLength
  verticalDistance([right.start, right.end]) == trayWidth
}
outerBody = extrude(
  region(
    segments = [
      outerProfile.bottom,
      outerProfile.right
    ],
    intersectionIndex = -1,
    direction = CCW,
  ),
  length = trayHeight,
)
hide(outerProfile)

cavityProfile = sketch(on = XY) {
  bottom = line(start = [var -112mm, var -32mm], end = [var 112mm, var -32mm])
  right = line(start = [var 112mm, var -32mm], end = [var 112mm, var 32mm])
  top = line(start = [var 112mm, var 32mm], end = [var -112mm, var 32mm])
  left = line(start = [var -112mm, var 32mm], end = [var -112mm, var -32mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, ORIGIN]) == trayLength / 2 - wallThickness
  verticalDistance([bottom.start, ORIGIN]) == trayWidth / 2 - wallThickness
  horizontalDistance([bottom.start, bottom.end]) == trayLength - (2 * wallThickness)
  verticalDistance([right.start, right.end]) == trayWidth - (2 * wallThickness)
}
cavityTool = extrude(
  region(
    segments = [
      cavityProfile.bottom,
      cavityProfile.right
    ],
    intersectionIndex = -1,
    direction = CCW,
  ),
  length = trayHeight,
)
  |> translate(z = wallThickness, global = true)
hide(cavityProfile)
hollowTray = subtract(outerBody, tools = [cavityTool])

cornerPostRadius = 6mm
cornerPostX = 103mm
cornerPostY = 27mm
pilotRadius = 1.2mm
postProfile = sketch(on = XY) {
  postCircle = circle(center = [var 0mm, var 0mm], start = [var 6mm, var 0mm])
  coincident([postCircle.center, ORIGIN])
  radius(postCircle) == cornerPostRadius
  horizontal([postCircle.center, postCircle.start])
}
cornerPost = extrude(region(segments = [postProfile.postCircle]), length = trayHeight - wallThickness)
  |> translate(
       x = -cornerPostX,
       y = -cornerPostY,
       z = wallThickness - 0.1mm,
       global = true,
     )
hide(postProfile)
cornerPosts = patternLinear3d(
  cornerPost,
  instances = 2,
  distance = 2 * cornerPostX,
  axis = [1, 0, 0],
)
  |> patternLinear3d(instances = 2, distance = 2 * cornerPostY, axis = [0, 1, 0])
trayCornerOne = union([hollowTray, cornerPosts[0]])
trayCornerTwo = union([trayCornerOne, cornerPosts[1]])
trayCornerThree = union([trayCornerTwo, cornerPosts[2]])
trayWithCorners = union([trayCornerThree, cornerPosts[3]])

carrierPostRadius = 4.5mm
carrierPostX = 78mm
carrierPostHeight = 8mm
carrierPostProfile = sketch(on = XY) {
  postCircle = circle(center = [var 0mm, var 0mm], start = [var 4.5mm, var 0mm])
  coincident([postCircle.center, ORIGIN])
  radius(postCircle) == carrierPostRadius
  horizontal([postCircle.center, postCircle.start])
}
carrierPost = extrude(region(segments = [carrierPostProfile.postCircle]), length = carrierPostHeight - wallThickness + 0.1mm)
  |> translate(x = -carrierPostX, z = wallThickness - 0.1mm, global = true)
hide(carrierPostProfile)
carrierPosts = patternLinear3d(
  carrierPost,
  instances = 2,
  distance = 2 * carrierPostX,
  axis = [1, 0, 0],
)
trayCarrierOne = union([trayWithCorners, carrierPosts[0]])
trayWithPosts = union([trayCarrierOne, carrierPosts[1]])

pilotProfile = sketch(on = XY) {
  pilotCircle = circle(center = [var 0mm, var 0mm], start = [var 1.2mm, var 0mm])
  coincident([pilotCircle.center, ORIGIN])
  radius(pilotCircle) == pilotRadius
  horizontal([pilotCircle.center, pilotCircle.start])
}
cornerPilot = extrude(region(segments = [pilotProfile.pilotCircle]), length = 13mm)
  |> translate(
       x = -cornerPostX,
       y = -cornerPostY,
       z = trayHeight - 12mm,
       global = true,
     )
cornerPilots = patternLinear3d(
  cornerPilot,
  instances = 2,
  distance = 2 * cornerPostX,
  axis = [1, 0, 0],
)
  |> patternLinear3d(instances = 2, distance = 2 * cornerPostY, axis = [0, 1, 0])
trayWithLidPilots = subtract(trayWithPosts, tools = cornerPilots)
carrierPilot = extrude(region(segments = [pilotProfile.pilotCircle]), length = 5mm)
  |> translate(x = -carrierPostX, z = 4mm, global = true)
carrierPilots = patternLinear3d(
  carrierPilot,
  instances = 2,
  distance = 2 * carrierPostX,
  axis = [1, 0, 0],
)
hide(pilotProfile)
trayWithCarrierPilots = subtract(trayWithLidPilots, tools = carrierPilots)

// Open the middle of the west end while retaining the floor and side-wall frame.
westOpeningWidth = 52mm
westOpeningProfile = sketch(on = XY) {
  bottom = line(start = [var 111.9mm, var -26mm], end = [var 115.2mm, var -26mm])
  right = line(start = [var 115.2mm, var -26mm], end = [var 115.2mm, var 26mm])
  top = line(start = [var 115.2mm, var 26mm], end = [var 111.9mm, var 26mm])
  left = line(start = [var 111.9mm, var 26mm], end = [var 111.9mm, var -26mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([ORIGIN, bottom.start]) == trayLength / 2 - wallThickness - 0.1mm
  verticalDistance([bottom.start, ORIGIN]) == westOpeningWidth / 2
  horizontalDistance([bottom.start, bottom.end]) == wallThickness + 0.3mm
  verticalDistance([right.start, right.end]) == westOpeningWidth
}
westOpeningRegion = region(
  segments = [
    westOpeningProfile.bottom,
    westOpeningProfile.right
  ],
  intersectionIndex = -1,
  direction = CCW,
)
hide(westOpeningProfile)
westOpeningTool = extrude(westOpeningRegion, length = trayHeight - wallThickness + 1mm)
  |> translate(z = wallThickness, global = true)
trayWithWestOpening = subtract(trayWithCarrierPilots, tools = [westOpeningTool])

// Two internal bosses attach to existing corner posts and support the end panel.
westBossRadius = 4.5mm
westBossY = 22mm
westBossZ = 34mm
westBossProfile = sketch(on = YZ) {
  boss = circle(center = [var 0mm, var 0mm], start = [var 4.5mm, var 0mm])
  coincident([boss.center, ORIGIN])
  radius(boss) == westBossRadius
  horizontal([boss.center, boss.start])
}
westBossRegion = region(segments = [westBossProfile.boss])
hide(westBossProfile)
westBossBlank = extrude(westBossRegion, length = 11mm)
  |> translate(
       x = 101mm,
       y = -westBossY,
       z = westBossZ,
       global = true,
     )
westBosses = patternLinear3d(
  westBossBlank,
  instances = 2,
  distance = 2 * westBossY,
  axis = [0, 1, 0],
)
trayWithFirstWestBoss = union([trayWithWestOpening, westBosses[0]])
trayWithWestBosses = union([trayWithFirstWestBoss, westBosses[1]])

westPilotProfile = sketch(on = YZ) {
  pilot = circle(center = [var 0mm, var 0mm], start = [var 1.2mm, var 0mm])
  coincident([pilot.center, ORIGIN])
  radius(pilot) == pilotRadius
  horizontal([pilot.center, pilot.start])
}
westPilotRegion = region(segments = [westPilotProfile.pilot])
hide(westPilotProfile)
westPilotBlank = extrude(westPilotRegion, length = 9mm)
  |> translate(
       x = 104mm,
       y = -westBossY,
       z = westBossZ,
       global = true,
     )
westPilots = patternLinear3d(
  westPilotBlank,
  instances = 2,
  distance = 2 * westBossY,
  axis = [0, 1, 0],
)
trayWithWestPilots = subtract(trayWithWestBosses, tools = westPilots)

// Supply openings sit near the east end, clear of the corner posts.
vlPortX = -80mm
vlPortHeight = 34mm
vlRetainedThickness = 1.5mm
vlTopKeyWidth = 9.8mm
vlTopKeyHeight = 3.2mm
vlTwoBodyWidth = 13.8mm
vlTwoOverallWidth = 20.6mm
vlTwoBodyHeight = 8.5mm
vlTwoWingHeight = 5.7mm
vlTwoWingOffset = 1.4mm
vlTwoBottomKeyWidth = 4.2mm
vlTwoBottomKeyHeight = 0.5mm
vlSixBodyWidth = 20mm
vlSixOverallWidth = 26.8mm
vlSixBodyHeight = 15.4mm
vlSixWingHeight = 7mm
vlSixWingOffset = 4.2mm
vlSixTotalHeight = 18.6mm
vlReliefWidth = vlSixOverallWidth + 4mm
vlReliefHeight = vlSixTotalHeight + 4mm

// VLR-02V single-row north opening; top and bottom keys face vertically.
vlTwoProfile = sketch(on = XZ) {
  keyBottom = line(start = [var -2.1mm, var -6.1mm], end = [var 2.1mm, var -6.1mm])
  keyBottomRight = line(start = [var 2.1mm, var -6.1mm], end = [var 2.1mm, var -5.6mm])
  bottomRight = line(start = [var 2.1mm, var -5.6mm], end = [var 6.9mm, var -5.6mm])
  lowerRight = line(start = [var 6.9mm, var -5.6mm], end = [var 6.9mm, var -4.2mm])
  lowerRightArm = line(start = [var 6.9mm, var -4.2mm], end = [var 10.3mm, var -4.2mm])
  rightWall = line(start = [var 10.3mm, var -4.2mm], end = [var 10.3mm, var 1.5mm])
  upperRightArm = line(start = [var 10.3mm, var 1.5mm], end = [var 6.9mm, var 1.5mm])
  upperRight = line(start = [var 6.9mm, var 1.5mm], end = [var 6.9mm, var 2.9mm])
  topRight = line(start = [var 6.9mm, var 2.9mm], end = [var 4.9mm, var 2.9mm])
  keyRight = line(start = [var 4.9mm, var 2.9mm], end = [var 4.9mm, var 6.1mm])
  keyTop = line(start = [var 4.9mm, var 6.1mm], end = [var -4.9mm, var 6.1mm])
  keyLeft = line(start = [var -4.9mm, var 6.1mm], end = [var -4.9mm, var 2.9mm])
  topLeft = line(start = [var -4.9mm, var 2.9mm], end = [var -6.9mm, var 2.9mm])
  upperLeft = line(start = [var -6.9mm, var 2.9mm], end = [var -6.9mm, var 1.5mm])
  upperLeftArm = line(start = [var -6.9mm, var 1.5mm], end = [var -10.3mm, var 1.5mm])
  leftWall = line(start = [var -10.3mm, var 1.5mm], end = [var -10.3mm, var -4.2mm])
  lowerLeftArm = line(start = [var -10.3mm, var -4.2mm], end = [var -6.9mm, var -4.2mm])
  lowerLeft = line(start = [var -6.9mm, var -4.2mm], end = [var -6.9mm, var -5.6mm])
  bottomLeft = line(start = [var -6.9mm, var -5.6mm], end = [var -2.1mm, var -5.6mm])
  keyBottomLeft = line(start = [var -2.1mm, var -5.6mm], end = [var -2.1mm, var -6.1mm])
  coincident([keyBottom.end, keyBottomRight.start])
  coincident([keyBottomRight.end, bottomRight.start])
  coincident([bottomRight.end, lowerRight.start])
  coincident([lowerRight.end, lowerRightArm.start])
  coincident([lowerRightArm.end, rightWall.start])
  coincident([rightWall.end, upperRightArm.start])
  coincident([upperRightArm.end, upperRight.start])
  coincident([upperRight.end, topRight.start])
  coincident([topRight.end, keyRight.start])
  coincident([keyRight.end, keyTop.start])
  coincident([keyTop.end, keyLeft.start])
  coincident([keyLeft.end, topLeft.start])
  coincident([topLeft.end, upperLeft.start])
  coincident([upperLeft.end, upperLeftArm.start])
  coincident([upperLeftArm.end, leftWall.start])
  coincident([leftWall.end, lowerLeftArm.start])
  coincident([lowerLeftArm.end, lowerLeft.start])
  coincident([lowerLeft.end, bottomLeft.start])
  coincident([bottomLeft.end, keyBottomLeft.start])
  coincident([keyBottomLeft.end, keyBottom.start])
  horizontal(keyBottom)
  vertical(keyBottomRight)
  horizontal(bottomRight)
  vertical(lowerRight)
  horizontal(lowerRightArm)
  vertical(rightWall)
  horizontal(upperRightArm)
  vertical(upperRight)
  horizontal(topRight)
  vertical(keyRight)
  horizontal(keyTop)
  vertical(keyLeft)
  horizontal(topLeft)
  vertical(upperLeft)
  horizontal(upperLeftArm)
  vertical(leftWall)
  horizontal(lowerLeftArm)
  vertical(lowerLeft)
  horizontal(bottomLeft)
  vertical(keyBottomLeft)
  horizontal([leftWall.end, rightWall.start])
  horizontal([leftWall.start, rightWall.end])
  horizontal([topLeft.end, topRight.start])
  horizontal([bottomLeft.start, bottomRight.end])
  vertical([lowerRight.end, upperRight.start])
  vertical([lowerLeft.start, upperLeft.end])
  horizontalDistance([keyBottom.start, keyBottom.end]) == vlTwoBottomKeyWidth
  horizontalDistance([bottomLeft.start, bottomRight.end]) == vlTwoBodyWidth
  horizontalDistance([leftWall.start, rightWall.end]) == vlTwoOverallWidth
  horizontalDistance([keyTop.end, keyTop.start]) == vlTopKeyWidth
  horizontalDistance([keyBottom.start, ORIGIN]) == vlTwoBottomKeyWidth / 2
  horizontalDistance([bottomLeft.start, ORIGIN]) == vlTwoBodyWidth / 2
  horizontalDistance([leftWall.start, ORIGIN]) == vlTwoOverallWidth / 2
  horizontalDistance([keyTop.end, ORIGIN]) == vlTopKeyWidth / 2
  verticalDistance([keyBottom.start, ORIGIN]) == 6.1mm
  verticalDistance([
    keyBottomRight.start,
    keyBottomRight.end
  ]) == vlTwoBottomKeyHeight
  verticalDistance([lowerRight.start, lowerRight.end]) == vlTwoWingOffset
  verticalDistance([rightWall.start, rightWall.end]) == vlTwoWingHeight
  verticalDistance([lowerRight.start, topRight.start]) == vlTwoBodyHeight
  verticalDistance([keyRight.start, keyRight.end]) == vlTopKeyHeight
}
vlTwoTool = extrude(
  region(
    segments = [
      vlTwoProfile.keyBottom,
      vlTwoProfile.keyBottomRight
    ],
    intersectionIndex = -1,
    direction = CCW,
  ),
  length = wallThickness + 2mm,
  direction = [0, 1, 0],
)
  |> translate(
       x = vlPortX,
       y = trayWidth / 2 - wallThickness - 1mm,
       z = vlPortHeight,
       global = true,
     )
hide(vlTwoProfile)
trayWithNorthVl = subtract(trayWithWestPilots, tools = [vlTwoTool])

// VLR-06V dual-row south opening.
vlSixProfile = sketch(on = XZ) {
  bottom = line(start = [var -10mm, var -9.3mm], end = [var 10mm, var -9.3mm])
  lowerRight = line(start = [var 10mm, var -9.3mm], end = [var 10mm, var -5.1mm])
  lowerRightArm = line(start = [var 10mm, var -5.1mm], end = [var 13.4mm, var -5.1mm])
  rightWall = line(start = [var 13.4mm, var -5.1mm], end = [var 13.4mm, var 1.9mm])
  upperRightArm = line(start = [var 13.4mm, var 1.9mm], end = [var 10mm, var 1.9mm])
  upperRight = line(start = [var 10mm, var 1.9mm], end = [var 10mm, var 6.1mm])
  topRight = line(start = [var 10mm, var 6.1mm], end = [var 4.9mm, var 6.1mm])
  keyRight = line(start = [var 4.9mm, var 6.1mm], end = [var 4.9mm, var 9.3mm])
  keyTop = line(start = [var 4.9mm, var 9.3mm], end = [var -4.9mm, var 9.3mm])
  keyLeft = line(start = [var -4.9mm, var 9.3mm], end = [var -4.9mm, var 6.1mm])
  topLeft = line(start = [var -4.9mm, var 6.1mm], end = [var -10mm, var 6.1mm])
  upperLeft = line(start = [var -10mm, var 6.1mm], end = [var -10mm, var 1.9mm])
  upperLeftArm = line(start = [var -10mm, var 1.9mm], end = [var -13.4mm, var 1.9mm])
  leftWall = line(start = [var -13.4mm, var 1.9mm], end = [var -13.4mm, var -5.1mm])
  lowerLeftArm = line(start = [var -13.4mm, var -5.1mm], end = [var -10mm, var -5.1mm])
  lowerLeft = line(start = [var -10mm, var -5.1mm], end = [var -10mm, var -9.3mm])
  coincident([bottom.end, lowerRight.start])
  coincident([lowerRight.end, lowerRightArm.start])
  coincident([lowerRightArm.end, rightWall.start])
  coincident([rightWall.end, upperRightArm.start])
  coincident([upperRightArm.end, upperRight.start])
  coincident([upperRight.end, topRight.start])
  coincident([topRight.end, keyRight.start])
  coincident([keyRight.end, keyTop.start])
  coincident([keyTop.end, keyLeft.start])
  coincident([keyLeft.end, topLeft.start])
  coincident([topLeft.end, upperLeft.start])
  coincident([upperLeft.end, upperLeftArm.start])
  coincident([upperLeftArm.end, leftWall.start])
  coincident([leftWall.end, lowerLeftArm.start])
  coincident([lowerLeftArm.end, lowerLeft.start])
  coincident([lowerLeft.end, bottom.start])
  horizontal(bottom)
  vertical(lowerRight)
  horizontal(lowerRightArm)
  vertical(rightWall)
  horizontal(upperRightArm)
  vertical(upperRight)
  horizontal(topRight)
  vertical(keyRight)
  horizontal(keyTop)
  vertical(keyLeft)
  horizontal(topLeft)
  vertical(upperLeft)
  horizontal(upperLeftArm)
  vertical(leftWall)
  horizontal(lowerLeftArm)
  vertical(lowerLeft)
  horizontal([leftWall.end, rightWall.start])
  horizontal([leftWall.start, rightWall.end])
  horizontal([topLeft.end, topRight.start])
  vertical([lowerRight.end, upperRight.start])
  vertical([lowerLeft.start, upperLeft.end])
  horizontalDistance([bottom.start, bottom.end]) == vlSixBodyWidth
  horizontalDistance([leftWall.start, rightWall.end]) == vlSixOverallWidth
  horizontalDistance([keyTop.end, keyTop.start]) == vlTopKeyWidth
  horizontalDistance([bottom.start, ORIGIN]) == vlSixBodyWidth / 2
  horizontalDistance([leftWall.start, ORIGIN]) == vlSixOverallWidth / 2
  horizontalDistance([keyTop.end, ORIGIN]) == vlTopKeyWidth / 2
  verticalDistance([bottom.start, ORIGIN]) == vlSixTotalHeight / 2
  verticalDistance([lowerRight.start, lowerRight.end]) == vlSixWingOffset
  verticalDistance([rightWall.start, rightWall.end]) == vlSixWingHeight
  verticalDistance([bottom.start, topRight.start]) == vlSixBodyHeight
  verticalDistance([keyRight.start, keyRight.end]) == vlTopKeyHeight
}
vlSixTool = extrude(
  region(
    segments = [
      vlSixProfile.bottom,
      vlSixProfile.lowerRight
    ],
    intersectionIndex = -1,
    direction = CCW,
  ),
  length = wallThickness + 2mm,
  direction = [0, 1, 0],
)
  |> translate(
       x = vlPortX,
       y = -trayWidth / 2 - 1mm,
       z = vlPortHeight,
       global = true,
     )
hide(vlSixProfile)
trayWithVlCuts = subtract(trayWithNorthVl, tools = [vlSixTool])

// Interior reliefs leave 1.5 mm nominal thickness for the VL retainers.
vlReliefProfile = sketch(on = XZ) {
  bottom = line(start = [var -15.4mm, var -11.3mm], end = [var 15.4mm, var -11.3mm])
  right = line(start = [var 15.4mm, var -11.3mm], end = [var 15.4mm, var 11.3mm])
  top = line(start = [var 15.4mm, var 11.3mm], end = [var -15.4mm, var 11.3mm])
  left = line(start = [var -15.4mm, var 11.3mm], end = [var -15.4mm, var -11.3mm])
  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])
  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)
  horizontalDistance([bottom.start, bottom.end]) == vlReliefWidth
  verticalDistance([right.start, right.end]) == vlReliefHeight
  horizontalDistance([bottom.start, ORIGIN]) == vlReliefWidth / 2
  verticalDistance([bottom.start, ORIGIN]) == vlReliefHeight / 2
}
vlReliefBlank = extrude(
  region(
    segments = [
      vlReliefProfile.bottom,
      vlReliefProfile.right
    ],
    intersectionIndex = -1,
    direction = CCW,
  ),
  length = wallThickness - vlRetainedThickness,
  direction = [0, 1, 0],
)
hide(vlReliefProfile)
vlSouthReliefBlank = clone(vlReliefBlank)
vlNorthRelief = translate(
  vlReliefBlank,
  x = vlPortX,
  y = trayWidth / 2 - wallThickness,
  z = vlPortHeight,
  global = true,
)
vlSouthRelief = translate(
  vlSouthReliefBlank,
  x = vlPortX,
  y = -trayWidth / 2 + vlRetainedThickness,
  z = vlPortHeight,
  global = true,
)
trayWithNorthRelief = subtract(trayWithVlCuts, tools = [vlNorthRelief])
tray = subtract(trayWithNorthRelief, tools = [vlSouthRelief])
