// Combined-supply slide-wall review.
// Set dualOnNorth to place both inputs on north or south; the other wall is blank.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

import "concepts/openFrameBench/main.kcl" as framePart
import plainSkin, eastSkin from "concepts/openFrameSlideWalls/main.kcl"
import "openFrameCeiling.kcl" as ceilingPart
import "openFrameSupplyBoth.kcl" as dualPart
import "openFrameSupplyBlank.kcl" as blankPart
import "openFrameWestSlide.kcl" as westPart

dualOnNorth = false
frame = appearance(framePart, color = "#728a7f")
ceiling = translate(ceilingPart, z = 82mm, global = true)
  |> appearance(color = "#d6dadd")
westPanel = translate(
  westPart,
  x = 115mm,
  z = 36mm,
  global = true,
)
  |> appearance(color = "#a8c2cb")

dualPanel = if dualOnNorth {
  rotate(
    dualPart,
    axis = X,
    angle = 90deg,
    global = true,
  )
    |> rotate(axis = Z, angle = 180deg, global = true)
    |> translate(
         x = -55mm,
         y = 33.4mm,
         z = 42.5mm,
         global = true,
       )
    |> appearance(color = "#56646d")
} else {
  rotate(
    dualPart,
    axis = X,
    angle = 90deg,
    global = true,
  )
    |> translate(
         x = -55mm,
         y = -33.4mm,
         z = 42.5mm,
         global = true,
       )
    |> appearance(color = "#56646d")
}
blankPanel = if dualOnNorth {
  rotate(
    blankPart,
    axis = X,
    angle = 90deg,
    global = true,
  )
    |> translate(
         x = -55mm,
         y = -33.4mm,
         z = 42.5mm,
         global = true,
       )
    |> appearance(color = "#c4b59b")
} else {
  rotate(
    blankPart,
    axis = X,
    angle = 90deg,
    global = true,
  )
    |> rotate(axis = Z, angle = 180deg, global = true)
    |> translate(
         x = -55mm,
         y = 33.4mm,
         z = 42.5mm,
         global = true,
       )
    |> appearance(color = "#c4b59b")
}
northPlainWall = translate(
  clone(plainSkin),
  x = 55mm,
  y = 36.4mm,
  z = 3.2mm,
  global = true,
)
  |> appearance(color = "#56646d")
southPlainWall = translate(
  plainSkin,
  x = 55mm,
  y = -34.8mm,
  z = 3.2mm,
  global = true,
)
  |> appearance(color = "#56646d")
eastCover = rotate(
  eastSkin,
  axis = Z,
  angle = 180deg,
  global = true,
)
  |> translate(x = -115mm, z = 3.2mm, global = true)
  |> appearance(color = "#687983")
