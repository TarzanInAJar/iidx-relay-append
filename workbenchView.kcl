// Workbench review layout
// Exploded reference view of the lid, west panel and two carrier tiers.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

import "tray.kcl" as trayPart
import "ceiling.kcl" as ceilingPart
import "westPanel.kcl" as westPanelPart
import "carrier.kcl" as carrierPart
import "upperCarrier.kcl" as upperCarrierPart
import "carrierSpacer.kcl" as spacerPart
import "wagoFiveEnvelope.kcl" as fivePortPart
import "wagoTenEnvelope.kcl" as tenPortPart
import "wagoFiveRetainer.kcl" as fiveRetainerPart
import "wagoTenRetainer.kcl" as tenRetainerPart
import "xmrFiveEnvelope.kcl" as xmrFivePart

lidReviewHeight = 135mm
westPanelReviewOffset = 28mm
carrierReviewOffset = -95mm
carrierReviewHeight = 8mm
upperCarrierReviewOffset = -155mm
carrierThickness = 2mm
markerPitch = 24mm
ceilingPairPitch = 24mm
ceilingPairGroupPitch = 60mm

// Separate upper/lower plates and freely removable spacer parts.
secondSpacerBlank = clone(spacerPart)
lowerGroundFiveBlank = clone(fivePortPart)
upperPowerFiveBlank = clone(fivePortPart)
upperGroundFiveBlank = clone(fivePortPart)
groundTenBlank = clone(tenPortPart)
fiveRetainerTestBlank = clone(fivePortPart)
tenRetainerTestBlank = clone(tenPortPart)
lowerFiveRetainerBlank = clone(fiveRetainerPart)
upperFiveRetainerBlank = clone(fiveRetainerPart)
upperTenRetainerBlank = clone(tenRetainerPart)

tray = appearance(trayPart, color = "#495c68", roughness = 75)
westPanel = translate(
  westPanelPart,
  x = 112mm + westPanelReviewOffset,
  z = 33.5mm,
  global = true,
)
  |> appearance(color = "#74848a", roughness = 70)
carrier = translate(
  carrierPart,
  y = carrierReviewOffset,
  z = carrierReviewHeight,
  global = true,
)
  |> appearance(color = "#b5c3b9", roughness = 70)
upperCarrier = translate(
  upperCarrierPart,
  y = upperCarrierReviewOffset,
  z = carrierReviewHeight,
  global = true,
)
  |> appearance(color = "#b5c3b9", roughness = 70)
ceiling = translate(ceilingPart, z = lidReviewHeight, global = true)
  |> appearance(color = "#d6dadd", roughness = 65)
// XMR rear clearance references follow the exploded lid.
xmrFiveFirst = translate(
  xmrFivePart,
  x = -72mm,
  y = -12mm,
  z = lidReviewHeight,
  global = true,
)
  |> appearance(color = "#b58fc4", roughness = 65)
xmrFivePairs = patternLinear3d(
  xmrFiveFirst,
  instances = 2,
  distance = ceilingPairPitch,
  axis = [1, 0, 0],
)
  |> patternLinear3d(instances = 3, distance = ceilingPairGroupPitch, axis = [1, 0, 0])

// Spacers align with diagonal stack fastener holes on the lower plate.
eastSpacer = translate(
  spacerPart,
  x = -84mm,
  y = carrierReviewOffset + 13mm,
  z = carrierReviewHeight + carrierThickness,
  global = true,
)
  |> appearance(color = "#c6b58e", roughness = 65)
westSpacer = translate(
  secondSpacerBlank,
  x = 84mm,
  y = carrierReviewOffset - 13mm,
  z = carrierReviewHeight + carrierThickness,
  global = true,
)
  |> appearance(color = "#c6b58e", roughness = 65)

// The retainer instances are separate parts aligned with the carrier holes.
lowerFiveRetainerFirst = translate(
  lowerFiveRetainerBlank,
  x = -54mm,
  y = carrierReviewOffset,
  z = carrierReviewHeight + carrierThickness,
  global = true,
)
  |> appearance(color = "#7ea28d", roughness = 70)
lowerFiveRetainers = patternLinear3d(
  lowerFiveRetainerFirst,
  instances = 4,
  distance = 36mm,
  axis = [1, 0, 0],
)
upperFiveRetainerFirst = translate(
  upperFiveRetainerBlank,
  x = -54mm,
  y = upperCarrierReviewOffset,
  z = carrierReviewHeight + carrierThickness,
  global = true,
)
  |> appearance(color = "#7ea28d", roughness = 70)
upperFiveRetainers = patternLinear3d(
  upperFiveRetainerFirst,
  instances = 2,
  distance = 36mm,
  axis = [1, 0, 0],
)
upperTenRetainerFirst = translate(
  upperTenRetainerBlank,
  x = 18mm,
  y = upperCarrierReviewOffset,
  z = carrierReviewHeight + carrierThickness,
  global = true,
)
  |> appearance(color = "#7ea28d", roughness = 70)
upperTenRetainers = patternLinear3d(
  upperTenRetainerFirst,
  instances = 2,
  distance = 36mm,
  axis = [1, 0, 0],
)

// Measured WAGO envelopes omit levers, ports and rounded housing contours.
// Each lower-tier pair serves one proposed +5 V branch group.
lowerPowerFirst = scale(
  fivePortPart,
  x = 29.6 / 30,
  y = 18.1 / 18.8,
  z = 8.05 / 8.4,
  global = true,
)
  |> translate(
       x = -54mm,
       y = carrierReviewOffset,
       z = carrierReviewHeight + carrierThickness + 1.6mm,
       global = true,
     )
  |> appearance(color = "#e88b54", roughness = 60)
lowerPowerFive = patternLinear3d(
  lowerPowerFirst,
  instances = 2,
  distance = 72mm,
  axis = [1, 0, 0],
)
lowerGroundFirst = scale(
  lowerGroundFiveBlank,
  x = 29.6 / 30,
  y = 18.1 / 18.8,
  z = 8.05 / 8.4,
  global = true,
)
  |> translate(
       x = -18mm,
       y = carrierReviewOffset,
       z = carrierReviewHeight + carrierThickness + 1.6mm,
       global = true,
     )
  |> appearance(color = "#456a97", roughness = 60)
lowerGroundFive = patternLinear3d(
  lowerGroundFirst,
  instances = 2,
  distance = 72mm,
  axis = [1, 0, 0],
)
upperPowerFive = scale(
  upperPowerFiveBlank,
  x = 29.6 / 30,
  y = 18.1 / 18.8,
  z = 8.05 / 8.4,
  global = true,
)
  |> translate(
       x = -54mm,
       y = upperCarrierReviewOffset,
       z = carrierReviewHeight + carrierThickness + 1.6mm,
       global = true,
     )
  |> appearance(color = "#e88b54", roughness = 60)
upperGroundFive = scale(
  upperGroundFiveBlank,
  x = 29.6 / 30,
  y = 18.1 / 18.8,
  z = 8.05 / 8.4,
  global = true,
)
  |> translate(
       x = -18mm,
       y = upperCarrierReviewOffset,
       z = carrierReviewHeight + carrierThickness + 1.6mm,
       global = true,
     )
  |> appearance(color = "#456a97", roughness = 60)
// Upright ten-port envelopes, with wire-entry face above.
upperPowerTen = scale(
  tenPortPart,
  x = 29.6 / 29.8,
  y = 18.1 / 18.3,
  z = 15.6 / 15.8,
  global = true,
)
  |> rotate(axis = X, angle = -90deg, global = true)
  |> translate(
       x = 18mm,
       y = upperCarrierReviewOffset - 7.8mm,
       z = carrierReviewHeight + carrierThickness + 1.6mm + 9.05mm,
       global = true,
     )
  |> appearance(color = "#e6bd64", roughness = 60)
upperGroundTen = scale(
  groundTenBlank,
  x = 29.6 / 29.8,
  y = 18.1 / 18.3,
  z = 15.6 / 15.8,
  global = true,
)
  |> rotate(axis = X, angle = -90deg, global = true)
  |> translate(
       x = 54mm,
       y = upperCarrierReviewOffset - 7.8mm,
       z = carrierReviewHeight + carrierThickness + 1.6mm + 9.05mm,
       global = true,
     )
  |> appearance(color = "#456a97", roughness = 60)

// Separate fit-test retainers; the WAGO bodies are envelope-only references.
trialY = -225mm
fiveTrialRetainer = translate(
  fiveRetainerPart,
  x = -25mm,
  y = trialY,
  global = true,
)
  |> appearance(color = "#7ea28d", roughness = 70)
// Only the trial references use the measured connector envelopes.
fiveTrialEnvelope = scale(
  fiveRetainerTestBlank,
  x = 29.6 / 30,
  y = 18.1 / 18.8,
  z = 8.05 / 8.4,
  global = true,
)
  |> translate(
       x = -25mm,
       y = trialY,
       z = 1.6mm,
       global = true,
     )
  |> appearance(color = "#e88b54", roughness = 60)
tenTrialRetainer = translate(
  tenRetainerPart,
  x = 25mm,
  y = trialY,
  global = true,
)
  |> appearance(color = "#7ea28d", roughness = 70)
// Upright trial orientation; this plain envelope omits the levers and ports.
tenTrialEnvelope = scale(
  tenRetainerTestBlank,
  x = 29.6 / 29.8,
  y = 18.1 / 18.3,
  z = 15.6 / 15.8,
  global = true,
)
  |> rotate(axis = X, angle = -90deg, global = true)
  |> translate(
       x = 25mm,
       y = trialY - 7.8mm,
       z = 1.6mm + 9.05mm,
       global = true,
     )
  |> appearance(color = "#e6bd64", roughness = 60)
